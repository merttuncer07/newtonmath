# the four modules, reached from the language
use prelude
# systems: extermination by resultants, every solution put back
solve x^2 + y^2 = 5, x - y = 1 for x, y
solve x*y = 1, x + y = 3 for x, y
solve x^3 - 2x - 1 = 0 for x
solve x^3 - x - 1 for x
solve x^2 + 1 = 0 for x
solve x + y = 1, 2x + 2y = 2 for x, y
solve x = 1, x = 2 for x
eliminate y from x^2 + y^2 = 1, y = x^2
let R = eliminate y from y^2 = x^3 + a, y = x + b
# matrices
let A = [[1, 2], [3, 4]]
A^2
A * [1, 1]
det(A)
inverse(A)
A * inverse(A)
A^-2
transpose(A)
A / 2
rank([[1, 2], [2, 4]])
nullspace([[1, 2], [2, 4]])
charpoly(A)
eigenvalues([[2, 1], [1, 2]])
eigenvalues(A)
eigenvalues([[0, -1], [1, 0]])
linsolve([[1, 1], [1, -1]], [3, 1])
linsolve([[1, 1, 1], [1, 1, 1]], [3, 3])
det([[a, b], [c, d]])
charpoly([[a, b], [c, d]], s)
det([[sqrt(2), 1], [1, sqrt(2)]])
inverse([[1, 2], [2, 4]])
[[1, 2], [3]]
# whole numbers
gcd(12, 18, 30)
lcm(4, 6, 10)
mod(-7, 5)
powmod(2, 1000, 1000007)
powmod(3, -1, 7)
invmod(3, 7)
invmod(6, 9)
isprime(2^61 - 1)
isprime(91)
factor(2^64 + 1)
factor(-360)
factor(1)
divisors(28)
sigma(28)
phi(36)
nextprime(10^20)
# values at complex points, and fluxions at a point
exp(i)
exp(1 + i)
sin(1/2 + i/3)
(1 + 2i) * exp(i)
log1p(i/2)
sin'(1/2)
cos''(1)
atan(2i)
# series moved to a point: the starts become letters known by their values
exp(1 + x) to x^4
sin(1/2 + x) to x^3
let g = 1/(1 - x)
g(1/3)
g(2 + x) to x^3
