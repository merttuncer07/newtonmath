# Slice 8 answer key. Adjacent letter names are identifiers, so products use *.
(x^2 - a^2)/(x - a)
(x^3 - a^3)/(x - a)
(x^4 - a^4)/(x^2 - a^2)
(x^2 - 1)/(x^2 + 2x + 1)
(x^2 + 2*a*x + a^2)/(x^2 - a^2)
1/(x + a) + 1/(x - a)
a/(a - b) + b/(b - a)
(a/b)/(c/d)
(a*x + a)/(b*x + b)
gcd(6*a*x + 6a, 4x + 4)
inverse([[a, b], [c, d]])
inverse([[1, a], [a, 1]])
linsolve([[a, 1], [1, a]], [1, 0])
rank([[a, b], [c, d]])
a^2/(b + x)
a^2/(b + x) to x^3
# Zero, units, whole powers, and normalization.
gcd(0, x^2 - a^2)
gcd(x^2 - a^2, 7)
(x + a)/(x + a)
0/(x + a)
2/(-2x - 2a)
(x - a)/(a^2 - x^2)
-1/(x + a)
((x + a)/(x - a))^-2
(1/x)/(1/a)
1/(1 + sqrt(2))
(3 + 4i)/(1 - 2i)
# Persistence, rules, sequences, equality, and explicit series requests.
let quotient = 1/(1 - x)
quotient
quotient(1/3)
quotient(2 + x) to x^3
quotient to x^4
let fraction(t) = (t^2 - 1)/(t + 1)
fraction(x)
let T[0] = 1/(1 + x), T[k] = T[k - 1]/(1 + x)
T[2]
let same_fraction(t) = 1 if t = 1/(x + a), 0 otherwise
same_fraction((x - a)/(x^2 - a^2))
d/dx (1/(1 - x))
# Generic rank, true rank-drop loci, and formula poles.
nullspace([[a, b]])
rank([[a, 1], [0, 0]])
nullspace([[a, 1], [0, 0]])
rank([[1/a, 0], [0, 0]])
rank([[a, b, 0], [0, c, d]])
let generic_rank = rank([[a, b], [c, d]])
generic_rank + 1
let inverse_matrix = inverse([[a, b], [c, d]])
[[a, b], [c, d]] * inverse_matrix
solve a*x + y = 1, x + a*y = 0 for x, y
solve a*x + b*y = 0 for x, y
# Refusals are explicit; the existing explicit surd series still works.
x^(1/2)/(1 + x)
1/(sqrt(2) + x)
1/0
inverse([[a, a], [1, 1]])
1/(sqrt(2) + x) to x^3
# Rounding keeps its own verdict alongside the generic condition.
rank([[a]])/3 to 2 places
# Rational matrix arithmetic and characteristic polynomial.
[[1, 0], [0, 1]]/(a + b)
det([[1/(a+b), 0], [0, a+b]])
charpoly([[1/(a+b), 0], [0, 1]])
# Changing pivots does not change rank when another minor stays nonzero.
rank([[0, 1], [2, 3]])
nullspace([[0, 1]])
# Nonmonomial exact cancellation at three letters, and rational coefficients.
gcd((a+b)*(x+c)*(x+1), (a+b)*(x+c)*(x+2))
((a+b)*(x+c)*(x+1))/((a+b)*(x+c)*(x+2))
((x+a)/2)/((x+a)/3)
# Prime syntax on a bound rational quantity must not silently ignore a derivative.
quotient'(1/3)
quotient'(x) to x^3
# A generic rank carried through a matrix builtin keeps its qualification.
det([[rank([[a]])]])
