# Slice 5: rules, sequences, sums and cases. Expected output in tests/rules.out.
let f(x) = x^2 + 1
f(3)
f(a + 1)
let g(x, y) = x^2 + y^2
g(3, 4)
let fact(n) = 1 if n = 0, n * fact(n - 1) otherwise
fact(20)
let fib[0] = 0, fib[1] = 1, fib[k] = fib[k - 1] + fib[k - 2]
fib[100]
# Newton's binomial rule written in the language: each term from the one before (A, B, C, D ...)
let binom[0] = 1, binom[k] = (m - k + 1)/k * binom[k - 1]
binom[3]
let m = 1/2
sum(binom[k] x^k for k = 0 to 8)
# the rule in the language agrees with the rule built into the engine
sum(binom[k] x^k for k = 0 to 8) - sqrt(1 + x) to x^8
let m = 1/3
sum(binom[k] x^k for k = 0 to 6) - (1 + x)^(1/3) to x^6
# Newton's resolution of y^3 - 2y - 5 = 0 written as a sequence, against the built-in resolution
let N[0] = 2, N[k] = N[k - 1] - (N[k - 1]^3 - 2N[k - 1] - 5)/(3N[k - 1]^2 - 2)
N[5] to 30 places
N[5] - root of y^3 - 2y - 5 = 0 near 2 to 30 places
# Newton's table for Methodus Problem 2 as a recurrence: (k+1) c[k+1] = d[k] + c[k] + c[k-1]
let d(j) = 1 if j = 0, -3 if j = 1, 1 if j = 2, 0 otherwise
let c[0] = 0, c[1] = 1, c[k] = (d(k - 1) + c[k - 1] + c[k - 2])/k
sum(c[k] x^k for k = 0 to 6)
sum(c[k] x^k for k = 0 to 6) - root of y' = 1 - 3x + y + x^2 + x*y, y(0) = 0 to x^6
# rules on series
use prelude
f(sin(x)) to x^6
# what is refused, and why
let bad[k] = bad[k] + 1
bad[3]
fact(-1)
f(1, 2)
